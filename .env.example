# Ticketify — environment template.
# Copy this file to `.env` and fill in the real values. `.env` is git-ignored
# and never committed (per the team's policy on app config).
#
# Variables prefixed `EXPO_PUBLIC_` are inlined into the JS bundle at build
# time by Expo. Everything else stays server-side.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------

# Project URL, e.g. https://<project>.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Anon key for the project (Settings → API → Project API keys → `anon` `public`).
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Gemini (receipt parsing)
# ---------------------------------------------------------------------------

# Vertex AI / Gemini API key for the parse-ticket edge function.
# This one is NOT prefixed with EXPO_PUBLIC_ because it must stay server-side
# (the edge function reads it from the function's environment, not the
# client bundle). Set this in your local shell when running `supabase functions
# serve` or in the Supabase dashboard when deploying.
GEMINI_API_KEY=
EXPO_PUBLIC_GEMINI_MODEL=gemini-1.5-flash

# ---------------------------------------------------------------------------
# Pro subscription (RevenueCat)
# ---------------------------------------------------------------------------

# RevenueCat public SDK key (Settings → API → Public app-specific API keys).
# Leave blank in development unless you have already configured the
# dashboard and want the paywall live.
EXPO_PUBLIC_REVENUECAT_API_KEY=

# DEV-ONLY ESCAPE HATCH — DO NOT ENABLE IN PRODUCTION.
# When set to `true`, the Pro bootstrap shortcuts the gate to `isPro=true`
# without touching RevenueCat. Use this to see the Pro UI (charts,
# paywall bypass, unlimited scans) without setting up the full billing
# pipeline. Set to `false` (or leave unset) before any release build.
# Default: unset (treated as `false`).
EXPO_PUBLIC_PRO_OVERRIDE=false
