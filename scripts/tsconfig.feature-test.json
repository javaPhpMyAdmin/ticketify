      "@/lib/supabase": ["./scripts/test-stubs/supabase.ts"],
      "react-native": ["./scripts/test-stubs/react-native.ts"],
      "@/*": ["./src/*"]
    },
    "rootDir": ".."
  },
  "include": [
    "../src/features/home/api.ts",
    "../src/lib/supabase/feature-access.ts",
    "../src/lib/supabase/query-adapters.ts",
    "../src/lib/query-keys.ts",
    "../src/features/profile/api.ts",
    "../src/features/budget/api.ts",
    "../src/features/analytics/api.ts",
    "../src/features/tickets/api.ts",
    "../src/features/tickets/lib/picture-size.ts",
    "../supabase/functions/parse-ticket/lib/card.ts",
    "../src/lib/format.ts",
    "../src/types/index.ts",
    "../scripts/test-stubs/globals.d.ts",
    "../scripts/test-stubs/supabase.ts",
    "../scripts/test-stubs/expo-file-system.ts",
    "../scripts/test-stubs/react-native.ts"
  ]
}
