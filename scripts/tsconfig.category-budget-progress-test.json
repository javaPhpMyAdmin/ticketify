{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2020",
    "lib": ["es2020", "dom"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": "..",
    "paths": {
      "@/components": ["./scripts/test-stubs/components.ts"],
      "@/lib/supabase": ["./scripts/test-stubs/supabase.ts"],
      "@/lib/supabase/storage-adapter": ["./scripts/test-stubs/storage-adapter.ts"],
      "react-native": ["./scripts/test-stubs/react-native.ts"],
      "@/*": ["./src/*"]
    },
    "rootDir": ".."
  },
  "include": [
    "../src/features/analytics/category-budget-progress.ts",
    "../src/theme/colors.ts",
    "../src/types/index.ts",
    "../scripts/test-stubs/globals.d.ts"
  ]
}