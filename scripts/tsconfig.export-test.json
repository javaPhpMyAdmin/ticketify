{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2020",
    "lib": ["es2020", "dom"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": "..",
    "paths": {
      "@/*": ["./src/*"]
    },
    "rootDir": ".."
  },
  "include": [
    "../src/features/export/normalize.ts",
    "../src/features/export/csv.ts",
    "../src/features/export/pdf.ts",
    "../src/types/index.ts",
    "../scripts/test-stubs/globals.d.ts"
  ]
}
