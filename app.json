{
  "expo": {
    "name": "Ticketify",
    "slug": "ticketify",
    "version": "0.1.0",
    "owner": "chelobatdev",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ticketify",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tickettify.app"
    },
    "android": {
      "package": "com.tickettify.app",
      "versionCode": 7,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F8F9FA"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Ticketify to access your photos to scan receipts.",
          "cameraPermission": "Allow Ticketify to use your camera to scan receipts."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Ticketify to use your camera to scan receipts.",
          "recordAudioAndroid": false
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "extra": {
      "supabaseUrl": "https://YOUR-PROJECT.supabase.co",
      "supabaseAnonKey": "YOUR-ANON-KEY",
      "router": {},
      "eas": {
        "projectId": "4e833933-55a7-498b-aff4-a7841f9c5b18"
      }
    }
  }
}
