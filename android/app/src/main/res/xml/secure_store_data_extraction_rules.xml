<?xml version="1.0" encoding="utf-8"?>
<!--
  Data Extraction Rules for Android 12+ (API 31+).

  Mirrors expo-secure-store's defaults: backup everything except the
  `SecureStore` sharedpref, for both cloud-backup and device-transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="."/>
        <exclude domain="sharedpref" path="SecureStore"/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="."/>
        <exclude domain="sharedpref" path="SecureStore"/>
    </device-transfer>
</data-extraction-rules>
